{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "pets": {
      ".indexOn": ["ownerId"]
    },
    "feedingSchedules": {
      ".indexOn": ["petId", "status"]
    },
    "users": {
      ".indexOn": ["email"]
    },
    "notifications": {
      ".indexOn": ["userId", "read"]
    }
  }
}
